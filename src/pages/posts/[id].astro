---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { id: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = post.data.date
  .toLocaleDateString('en-US', {
    month: 'long',
    day: '2-digit',
    year: 'numeric',
  })
  .toUpperCase();

const tocItems = headings.filter((heading) => heading.depth === 2);
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={post.data.description ?? post.data.subtitle}
    />
    <title>{post.data.title} | EWHA DS</title>

    <style>
      :root {
        --green: #00664f;
        --green-dark: #004b3c;
        --green-light: #eaf3ef;
        --text: #171a19;
        --muted: #707674;
        --line: #dce4e1;
        --background: #fafbf9;
        --white: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family:
          Pretendard,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        width: min(1440px, calc(100% - 48px));
        margin: 0 auto;
      }

      /* =========================
         HEADER
      ========================= */

      .header {
        height: 88px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--line);
      }

      .brand {
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.04em;
      }

      .nav {
        display: flex;
        gap: 32px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      /* =========================
         ARTICLE HERO
      ========================= */

      .article-hero {
        padding: 70px 0 64px;
        border-bottom: 1px solid var(--line);
      }

      .article-topline {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 64px;

        color: var(--green);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.14em;
      }

      .article-title {
        max-width: 1100px;
        margin: 0;

        font-size: clamp(64px, 9vw, 138px);
        line-height: 0.88;
        letter-spacing: -0.07em;
        font-weight: 800;
      }

      .article-subtitle {
        max-width: 720px;
        margin-top: 38px;

        color: var(--muted);
        font-size: 24px;
        line-height: 1.55;
        letter-spacing: -0.025em;
      }

      .article-meta {
        display: flex;
        gap: 36px;
        margin-top: 58px;

        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
      }

      .article-meta span {
        color: var(--muted);
      }

      .article-meta strong {
        color: var(--text);
      }

      /* =========================
         ARTICLE GRID
      ========================= */

      .article-layout {
        display: grid;

        /*
          왼쪽 메타
          중앙 본문
          오른쪽 목차
        */
        grid-template-columns:
          minmax(150px, 190px)
          minmax(0, 760px)
          minmax(170px, 1fr);

        gap: 72px;
        align-items: start;

        padding: 80px 0 120px;
      }

      /* =========================
         LEFT SIDEBAR
      ========================= */

      .article-side {
        position: sticky;
        top: 32px;
        align-self: start;

        font-size: 12px;
        line-height: 1.8;
        color: var(--muted);
      }

      .side-block + .side-block {
        margin-top: 38px;
      }

      .side-label {
        margin-bottom: 14px;

        color: var(--green);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.16em;
      }

      .side-value {
        max-width: 150px;
        line-height: 1.6;
      }

      /* =========================
         ARTICLE CONTENT
      ========================= */

      .article-content {
        min-width: 0;
      }

      /*
        Markdown 안에 # 제목이 있어도
        Hero에 이미 제목이 있으므로 숨김
      */
      .article-content :global(h1) {
        display: none;
      }

      .article-content :global(h2) {
        scroll-margin-top: 40px;

        margin: 76px 0 26px;
        padding-top: 10px;

        font-size: 36px;
        line-height: 1.25;
        letter-spacing: -0.045em;
      }

      .article-content :global(h2:first-child) {
        margin-top: 0;
      }

      .article-content :global(h3) {
        scroll-margin-top: 40px;

        margin: 50px 0 18px;

        font-size: 24px;
        line-height: 1.35;
        letter-spacing: -0.03em;
      }

      .article-content :global(p) {
        margin: 0 0 24px;

        font-size: 17px;
        line-height: 1.9;
        letter-spacing: -0.012em;
      }

      .article-content :global(strong) {
        font-weight: 750;
      }

      .article-content :global(a) {
        color: var(--green);
        border-bottom: 1px solid var(--green);
      }

      .article-content :global(ul),
      .article-content :global(ol) {
        margin: 24px 0;
        padding-left: 24px;

        font-size: 17px;
        line-height: 1.85;
      }

      .article-content :global(li) {
        margin: 8px 0;
      }

      .article-content :global(blockquote) {
        margin: 42px 0;
        padding: 26px 30px;

        border-left: 3px solid var(--green);
        background: var(--green-light);
      }

      .article-content :global(blockquote p) {
        margin: 0;

        font-size: 19px;
        font-weight: 600;
        line-height: 1.7;
      }

      .article-content :global(code) {
        padding: 3px 6px;

        border-radius: 4px;
        background: #eef1ef;

        font-family:
          "SFMono-Regular",
          Consolas,
          monospace;

        font-size: 0.9em;
      }

      .article-content :global(pre) {
        overflow-x: auto;

        margin: 36px 0;
        padding: 26px;

        border-radius: 2px;

        background: #171a19;
        color: #f7f8f7;
      }

      .article-content :global(pre code) {
        padding: 0;
        background: transparent;
        color: inherit;
      }

      .article-content :global(img) {
        display: block;

        width: 100%;
        height: auto;

        margin: 42px 0;
      }

      .article-content :global(hr) {
        margin: 72px 0;

        border: 0;
        border-top: 1px solid var(--line);
      }

      .article-content :global(table) {
        width: 100%;
        margin: 36px 0;

        border-collapse: collapse;

        font-size: 14px;
        line-height: 1.6;
      }

      .article-content :global(th),
      .article-content :global(td) {
        padding: 14px 16px;
        border: 1px solid var(--line);
        text-align: left;
      }

      .article-content :global(th) {
        background: var(--green-light);
        font-weight: 700;
      }

      /* =========================
         RIGHT CONTENTS
      ========================= */

      .right-rail {
        position: sticky;
        top: 32px;
        align-self: start;

        padding-left: 30px;
        border-left: 1px solid var(--line);
      }

      .right-title {
        margin-bottom: 26px;

        color: var(--green);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.16em;
      }

      .toc {
        display: flex;
        flex-direction: column;
      }

      .toc-item {
        display: grid;
        grid-template-columns: 30px 1fr;
        gap: 12px;

        padding: 11px 0;

        color: var(--muted);

        font-size: 11px;
        font-weight: 650;
        line-height: 1.5;
        letter-spacing: 0.03em;

        transition:
          color 160ms ease,
          transform 160ms ease;
      }

      .toc-item:hover {
        color: var(--green);
        transform: translateX(3px);
      }

      .toc-number {
        color: var(--green);
        font-variant-numeric: tabular-nums;
      }

      .toc-empty {
        color: var(--muted);
        font-size: 12px;
        line-height: 1.65;
      }

      /* =========================
         END / FOOTER
      ========================= */

      .article-end {
        border-top: 1px solid var(--line);
        padding: 48px 0 80px;
      }

      .back {
        display: inline-flex;
        align-items: center;
        gap: 10px;

        font-size: 13px;
        font-weight: 700;

        transition:
          color 160ms ease,
          transform 160ms ease;
      }

      .back:hover {
        color: var(--green);
        transform: translateX(-3px);
      }

      .footer {
        border-top: 1px solid var(--line);
        padding: 36px 0 50px;

        display: flex;
        justify-content: space-between;

        color: var(--muted);
        font-size: 12px;
      }

      /* =========================
         TABLET
      ========================= */

      @media (max-width: 1100px) {
        .article-layout {
          grid-template-columns: 150px minmax(0, 1fr);
          gap: 48px;
        }

        .right-rail {
          display: none;
        }
      }

      /* =========================
         MOBILE
      ========================= */

      @media (max-width: 900px) {
        .page {
          width: min(100% - 28px, 1440px);
        }

        .header {
          height: 72px;
        }

        .nav {
          display: none;
        }

        .article-hero {
          padding: 52px 0;
        }

        .article-topline {
          margin-bottom: 44px;
        }

        .article-title {
          font-size: clamp(54px, 17vw, 90px);
        }

        .article-subtitle {
          margin-top: 28px;
          font-size: 20px;
        }

        .article-meta {
          flex-direction: column;
          gap: 10px;

          margin-top: 42px;
        }

        .article-layout {
          display: block;
          padding: 56px 0 90px;
        }

        .article-side,
        .right-rail {
          display: none;
        }

        .article-content :global(h2) {
          font-size: 30px;
        }

        .article-content :global(h3) {
          font-size: 22px;
        }

        .article-content :global(p),
        .article-content :global(ul),
        .article-content :global(ol) {
          font-size: 16px;
        }

        .footer {
          gap: 18px;
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <main class="page">
      <header class="header">
        <a href="/" class="brand">EWHA DS</a>

        <nav class="nav">
          <a href="/#tech">TECH</a>
          <a href="/#research">RESEARCH</a>
          <a href="/#career">CAREER</a>
          <a href="/#about">ABOUT</a>
        </nav>
      </header>

      <article>
        <header class="article-hero">
          <div class="article-topline">
            <span>{post.data.category}</span>
            <span>EWHA DS</span>
          </div>

          <h1 class="article-title">
            {post.data.title}
          </h1>

          <div class="article-subtitle">
            {post.data.subtitle}
          </div>

          <div class="article-meta">
            <div>
              <span>WRITTEN BY </span>
              <strong>{post.data.author}</strong>
            </div>

            <div>
              <span>PUBLISHED </span>
              <strong>{formattedDate}</strong>
            </div>
          </div>
        </header>

        <div class="article-layout">

          <!-- LEFT : META -->
          <aside class="article-side">
            <div class="side-block">
              <div class="side-label">CATEGORY</div>
              <div class="side-value">
                {post.data.category}
              </div>
            </div>

            <div class="side-block">
              <div class="side-label">AUTHOR</div>
              <div class="side-value">
                {post.data.author}
              </div>
            </div>

            <div class="side-block">
              <div class="side-label">PUBLISHED</div>
              <div class="side-value">
                {formattedDate}
              </div>
            </div>
          </aside>

          <!-- CENTER : ARTICLE -->
          <main class="article-content">
            <Content />
          </main>

          <!-- RIGHT : CONTENTS -->
          <aside class="right-rail">
            <div class="right-title">
              CONTENTS
            </div>

            {
              tocItems.length > 0 ? (
                <nav class="toc">
                  {tocItems.map((heading, index) => (
                    <a
                      class="toc-item"
                      href={`#${heading.slug}`}
                    >
                      <span class="toc-number">
                        {String(index + 1).padStart(2, '0')}
                      </span>

                      <span>
                        {heading.text}
                      </span>
                    </a>
                  ))}
                </nav>
              ) : (
                <div class="toc-empty">
                  목차가 없습니다.
                </div>
              )
            }
          </aside>

        </div>

        <div class="article-end">
          <a href="/" class="back">
            ← BACK TO EWHA DS
          </a>
        </div>
      </article>

      <footer class="footer">
        <span>EWHA DS</span>
        <span>© 2026 · TECH · RESEARCH · CAREER</span>
      </footer>
    </main>
  </body>
</html>
---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="EWHA DS 페이지를 찾을 수 없습니다."
    />

    <link rel="icon" type="image/png" href="/ewha-logo.png" />

    <title>404 | EWHA DS</title>

    <style>
      :root {
        --green: #00664f;
        --green-dark: #004b3c;
        --green-light: #eaf3ef;
        --text: #171a19;
        --muted: #707674;
        --line: #dce4e1;
        --background: #fafbf9;
        --white: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;

        background: var(--background);
        color: var(--text);

        font-family:
          Pretendard,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        width: min(1440px, calc(100% - 48px));
        margin: 0 auto;
      }

      /* =========================
         404
      ========================= */

      .error-page {
        min-height: calc(100vh - 220px);

        display: grid;
        grid-template-columns: 1.1fr 0.9fr;

        align-items: center;

        padding: 90px 0 110px;
      }

      .error-kicker {
        margin-bottom: 26px;

        color: var(--green);

        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.16em;
      }

      .error-code {
        margin: 0;

        font-size: clamp(120px, 18vw, 280px);
        line-height: 0.75;
        letter-spacing: -0.09em;
        font-weight: 800;
      }

      .error-copy {
        padding-left: 54px;
      }

      .error-copy h1 {
        margin: 0 0 24px;

        font-size: clamp(34px, 4vw, 58px);
        line-height: 1.05;
        letter-spacing: -0.055em;
      }

      .error-copy p {
        max-width: 470px;

        margin: 0;

        color: var(--muted);

        font-size: 17px;
        line-height: 1.75;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;

        margin-top: 38px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-height: 44px;

        padding: 0 18px;

        border: 1px solid var(--line);

        font-size: 12px;
        font-weight: 750;
        letter-spacing: 0.03em;

        transition:
          background 160ms ease,
          color 160ms ease,
          border-color 160ms ease,
          transform 160ms ease;
      }

      .button.primary {
        background: var(--green);
        border-color: var(--green);

        color: var(--white);
      }

      .button:hover {
        border-color: var(--green);
        color: var(--green);

        transform: translateY(-2px);
      }

      .button.primary:hover {
        background: var(--green-dark);
        border-color: var(--green-dark);

        color: var(--white);
      }

      /* =========================
         DECORATION
      ========================= */

      .error-visual {
        position: relative;

        height: 150px;

        margin-top: 54px;

        overflow: hidden;

        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .line {
        position: absolute;

        top: 50%;
        left: 0;
        right: 0;

        height: 1px;

        background: var(--line);
      }

      .node {
        position: absolute;

        top: 50%;

        width: 12px;
        height: 12px;

        border-radius: 50%;

        background: var(--green);

        transform: translate(-50%, -50%);
      }

      .node.one {
        left: 15%;
      }

      .node.two {
        left: 42%;
      }

      .node.three {
        left: 72%;
      }

      .node.four {
        left: 90%;
      }

      .missing {
        position: absolute;

        left: 58%;
        top: 50%;

        width: 56px;
        height: 30px;

        display: grid;
        place-items: center;

        transform: translate(-50%, -50%);

        border: 1px dashed var(--green);

        background: var(--background);
        color: var(--green);

        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.12em;
      }

      @media (max-width: 900px) {
        .page {
          width: min(100% - 28px, 1440px);
        }

        .error-page {
          min-height: auto;

          grid-template-columns: 1fr;

          gap: 54px;

          padding: 72px 0 90px;
        }

        .error-copy {
          padding-left: 0;
        }

        .error-code {
          font-size: clamp(110px, 38vw, 210px);
        }
      }
    </style>
  </head>

  <body>
    <main class="page">
      <Header />

      <section class="error-page">
        <div>
          <div class="error-kicker">
            EWHA DS · PAGE NOT FOUND
          </div>

          <div class="error-code">
            404
          </div>

          <div class="error-visual">
            <div class="line"></div>

            <div class="node one"></div>
            <div class="node two"></div>

            <div class="missing">
              MISSING
            </div>

            <div class="node three"></div>
            <div class="node four"></div>
          </div>
        </div>

        <div class="error-copy">
          <h1>
            Looks like this data point is missing.
          </h1>

          <p>
            요청한 페이지를 찾을 수 없습니다.
            주소가 변경되었거나 존재하지 않는 페이지일 수 있습니다.
            아래 메뉴에서 EWHA DS 콘텐츠를 계속 둘러보세요.
          </p>

          <div class="actions">
            <a href="/" class="button primary">
              BACK TO HOME ↗
            </a>

            <a href="/tech" class="button">
              TECH
            </a>

            <a href="/research" class="button">
              RESEARCH
            </a>

            <a href="/career" class="button">
              CAREER
            </a>
          </div>
        </div>
      </section>

      <Footer />
    </main>
  </body>
</html>
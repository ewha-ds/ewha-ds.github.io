---
import { buildToc } from "../lib/toc";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SEO from "./SEO.astro";
import ViewCount from "./ViewCount.astro";
import "katex/dist/katex.min.css";
import "../styles/article.css";
import { titleSize } from "../lib/title";
import { isPublished } from "../lib/posts";

interface Props {
  post: CollectionEntry<"posts">;
  /** 미리보기일 때 상단 띠에 표시할 문구. 없으면 공개 글 */
  preview?: string;
}

const { post, preview } = Astro.props;

const { Content, headings } = await render(post);

const formattedDate = post.data.date
  .toLocaleDateString("en-US", {
    month: "long",
    day: "2-digit",
    year: "numeric",
  })
  .toUpperCase();

// 목차 규칙은 src/lib/toc.ts
const tocItems = buildToc(headings);

// 글 끝 "다음에 읽을 글": 같은 카테고리 최신 글 우선, 모자라면 다른 카테고리 최신 글로 채움
const otherPosts = (await getCollection("posts"))
  .filter((p) => isPublished(p) && p.id !== post.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const nextReads = [
  ...otherPosts.filter((p) => p.data.category === post.data.category),
  ...otherPosts.filter((p) => p.data.category !== post.data.category),
].slice(0, 3);

const shortDate = (d: Date) =>
  d
    .toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" })
    .toUpperCase();

const activeCategory =
  post.data.category === "TECH"
    ? "TECH"
    : post.data.category === "RESEARCH"
      ? "RESEARCH"
      : post.data.category === "CAREER"
        ? "CAREER"
        : undefined;
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preview && <meta name="robots" content="noindex, nofollow" />}

    <SEO
      title={`${post.data.title} | EWHA DS`}
      description={post.data.description ?? post.data.subtitle}
      image={post.data.ogImage ?? "/default-og.png"}
      type="article"
      publishedTime={post.data.date}
      author={post.data.author}
    />

    <style>
      :root {
        --green: #00664f;
        --green-dark: #004b3c;
        --green-light: #eaf3ef;
        --text: #171a19;
        --muted: #707674;
        --line: #dce4e1;
        --background: #fafbf9;
        --white: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);

        font-family:
          Pretendard,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }
    </style>
  </head>

  <body>
    <div class="reading-progress" aria-hidden="true"></div>

    {
      preview && (
        <div class="preview-banner">
          미리보기 · {preview}
        </div>
      )
    }
    <main class="page">
      <Header active={activeCategory} />

      <article>
        <header class="article-hero">
          <div class="article-topline">
            <span>
              {post.data.category}
            </span>

            <span>
              EWHA DS
            </span>
          </div>

          <h1 class="article-title" data-size={titleSize(post.data.title)}>
            {post.data.title}
          </h1>

          <div class="article-subtitle">
            {post.data.subtitle}
          </div>

          <div class="article-meta">
            <div>
              <span>
                WRITTEN BY{" "}
              </span>

              {
                post.data.authorUrl ? (
                  <strong>
                    <a
                      href={post.data.authorUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="author-link"
                    >
                      {post.data.author} ↗
                    </a>
                  </strong>
                ) : (
                  <strong>
                    {post.data.author}
                  </strong>
                )
              }
            </div>

            <div>
              <span>
                PUBLISHED{" "}
              </span>

              <strong>
                {formattedDate}
              </strong>
            </div>

            <div data-views-wrap hidden>
              <span>
                VIEWS{" "}
              </span>

              <strong>
                <ViewCount />
              </strong>
            </div>
          </div>
        </header>

        <div class="article-layout">
          <aside class="article-side">
            <div class="side-block">
              <div class="side-label">
                CATEGORY
              </div>

              <div class="side-value">
                {post.data.category}
              </div>
            </div>

            <div class="side-block">
              <div class="side-label">
                AUTHOR
              </div>

              <div class="side-value">
                {
                  post.data.authorUrl ? (
                    <a
                      href={post.data.authorUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="author-link"
                    >
                      {post.data.author} ↗
                    </a>
                  ) : (
                    post.data.author
                  )
                }
              </div>
            </div>

            <div class="side-block">
              <div class="side-label">
                PUBLISHED
              </div>

              <div class="side-value">
                {formattedDate}
              </div>
            </div>

            <div class="side-block" data-views-wrap hidden>
              <div class="side-label">
                VIEWS
              </div>

              <div class="side-value">
                <ViewCount />
              </div>
            </div>
          </aside>

          <main class="article-content">
            <Content />
          </main>

          <aside class="right-rail">
            <div class="right-title">
              CONTENTS
            </div>

            {
              tocItems.length > 0 ? (
                <nav class="toc">
                  {
                    tocItems.map((heading) => (
                      <a
                        class:list={["toc-item", { "toc-sub": heading.sub }]}
                        href={`#${heading.slug}`}
                        data-slug={heading.slug}
                      >
                        <span class="toc-number">
                          {heading.number}
                        </span>

                        <span class="toc-text">
                          {heading.text}
                        </span>
                      </a>
                    ))
                  }
                </nav>
              ) : (
                <div class="toc-empty">
                  목차가 없습니다.
                </div>
              )
            }
          </aside>
        </div>

        {
          nextReads.length > 0 && (
            <section class="next-reads">
              <div class="next-label">
                NEXT READ · 다음에 읽을 글
              </div>

              <div class="next-grid">
                {
                  nextReads.map((p) => (
                    <a class="next-card" href={`/posts/${p.id}/`}>
                      <div class="next-meta">
                        <span>{p.data.category}</span>
                        <span>{shortDate(p.data.date)}</span>
                      </div>

                      <div class="next-title">
                        {p.data.title}
                      </div>

                      <div class="next-subtitle">
                        {p.data.subtitle}
                      </div>
                    </a>
                  ))
                }
              </div>
            </section>
          )
        }

        <div class="article-end">
          <a
            href={`/${post.data.category.toLowerCase()}`}
            class="back"
          >
            ← BACK TO {post.data.category}
          </a>
        </div>
      </article>

      <Footer />
    </main>

    <script>
      // 읽기 진행 바 + 목차 현재 위치 표시
      const content = document.querySelector<HTMLElement>(".article-content");
      const bar = document.querySelector<HTMLElement>(".reading-progress");
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(".toc-item[data-slug]")
      );
      const tocHeadings = tocLinks
        .map((link) => document.getElementById(link.dataset.slug ?? ""))
        .filter((el): el is HTMLElement => el !== null);

      let ticking = false;

      function update() {
        ticking = false;
        if (!content) return;

        // 본문 시작~끝 기준 진행률
        const rect = content.getBoundingClientRect();
        const total = rect.height - window.innerHeight * 0.6;
        const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
        if (bar) bar.style.transform = `scaleX(${progress})`;

        // 화면 위쪽 1/4 지점을 지난 마지막 제목이 현재 섹션
        const line = window.innerHeight * 0.25;
        let current: HTMLElement | undefined;
        for (const heading of tocHeadings) {
          if (heading.getBoundingClientRect().top <= line) current = heading;
          else break;
        }
        for (const link of tocLinks) {
          link.classList.toggle("is-active", link.dataset.slug === current?.id);
        }
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      update();
    </script>
  </body>
</html>
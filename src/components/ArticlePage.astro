---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SEO from "./SEO.astro";
import "katex/dist/katex.min.css";
import { titleSize } from "../lib/title";
import { isPublished } from "../lib/posts";

interface Props {
  post: CollectionEntry<"posts">;
  /** 미리보기일 때 상단 띠에 표시할 문구. 없으면 공개 글 */
  preview?: string;
}

const { post, preview } = Astro.props;

const { Content, headings } = await render(post);

const formattedDate = post.data.date
  .toLocaleDateString("en-US", {
    month: "long",
    day: "2-digit",
    year: "numeric",
  })
  .toUpperCase();

// 목차: 큰 제목(#, ##)만. ##가 없는 글(예: 인터뷰 질문을 ####로 쓴 글)은
// 글에서 가장 큰 제목 단계를 사용.
// 본문 제목에 붙은 번호("1.", "2.1")는 목차가 01, 02로 따로 매기므로 떼어낸다.
const tocDepth = Math.max(2, Math.min(...headings.map((heading) => heading.depth), 6));
const tocItems = headings
  .filter((heading) => heading.depth <= tocDepth)
  .map((heading) => ({
    ...heading,
    text: heading.text.replace(/^\d+(\.\d+)*\.?\s+/, "") || heading.text,
  }));

// 글 끝 "다음에 읽을 글": 같은 카테고리 최신 글 우선, 모자라면 다른 카테고리 최신 글로 채움
const otherPosts = (await getCollection("posts"))
  .filter((p) => isPublished(p) && p.id !== post.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const nextReads = [
  ...otherPosts.filter((p) => p.data.category === post.data.category),
  ...otherPosts.filter((p) => p.data.category !== post.data.category),
].slice(0, 3);

const shortDate = (d: Date) =>
  d
    .toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" })
    .toUpperCase();

const activeCategory =
  post.data.category === "TECH"
    ? "TECH"
    : post.data.category === "RESEARCH"
      ? "RESEARCH"
      : post.data.category === "CAREER"
        ? "CAREER"
        : undefined;
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {preview && <meta name="robots" content="noindex, nofollow" />}

    <SEO
      title={`${post.data.title} | EWHA DS`}
      description={post.data.description ?? post.data.subtitle}
      image={post.data.ogImage ?? "/default-og.png"}
      type="article"
      publishedTime={post.data.date}
      author={post.data.author}
    />

    <style>
      :root {
        --green: #00664f;
        --green-dark: #004b3c;
        --green-light: #eaf3ef;
        --text: #171a19;
        --muted: #707674;
        --line: #dce4e1;
        --background: #fafbf9;
        --white: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);

        font-family:
          Pretendard,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        width: min(1440px, calc(100% - 48px));
        margin: 0 auto;
      }

      /* =========================
         ARTICLE HERO
      ========================= */

      .article-hero {
        padding: 70px 0 64px;

        border-bottom: 1px solid var(--line);
      }

      .article-topline {
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-bottom: 64px;

        color: var(--green);

        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.14em;
      }

      .article-title {
        max-width: 1100px;
        margin: 0;

        font-size: clamp(64px, 9vw, 138px);
        line-height: 0.88;
        letter-spacing: -0.07em;
        font-weight: 800;
        word-break: keep-all;
      }

      /* 긴 제목(주로 한글)은 단계적으로 작게. 기준은 src/lib/title.ts */
      .article-title[data-size="long"] {
        font-size: clamp(48px, 6vw, 96px);
        line-height: 1.02;
        letter-spacing: -0.05em;
      }

      .article-title[data-size="xlong"] {
        font-size: clamp(40px, 4.6vw, 72px);
        line-height: 1.1;
        letter-spacing: -0.04em;
      }

      .article-subtitle {
        max-width: 720px;

        margin-top: 38px;

        color: var(--muted);

        font-size: 24px;
        line-height: 1.55;
        letter-spacing: -0.025em;
      }

      .article-meta {
        display: flex;
        gap: 36px;

        margin-top: 58px;

        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
      }

      .article-meta span {
        color: var(--muted);
      }

      .article-meta strong {
        color: var(--text);
      }

      /* =========================
         ARTICLE GRID
      ========================= */

      .article-layout {
        display: grid;

        grid-template-columns:
          minmax(150px, 190px)
          minmax(0, 760px)
          minmax(170px, 1fr);

        gap: 72px;

        align-items: start;

        padding: 80px 0 120px;
      }

      /* =========================
         LEFT SIDEBAR
      ========================= */

      .article-side {
        position: sticky;
        top: 32px;

        align-self: start;

        color: var(--muted);

        font-size: 12px;
        line-height: 1.8;
      }

      .side-block + .side-block {
        margin-top: 38px;
      }

      .side-label {
        margin-bottom: 14px;

        color: var(--green);

        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.16em;
      }

      .side-value {
        max-width: 150px;
        line-height: 1.6;
      }

      /* =========================
         ARTICLE CONTENT
      ========================= */

      .article-content {
        min-width: 0;
      }

      .article-content :global(h1),
      .article-content :global(h2) {
        scroll-margin-top: 40px;

        margin: 76px 0 26px;
        padding-top: 10px;

        font-size: 36px;
        line-height: 1.25;
        letter-spacing: -0.045em;
      }

      .article-content :global(h1:first-child),
      .article-content :global(h2:first-child) {
        margin-top: 0;
      }

      .article-content :global(h3) {
        scroll-margin-top: 40px;

        margin: 50px 0 18px;

        font-size: 24px;
        line-height: 1.35;
        letter-spacing: -0.03em;
      }

      /* ####: 강조 박스 (인터뷰 질문 등). CMS에서는 Source 모드로 줄 앞에 '#### ' 입력 */
      .article-content :global(h4) {
        scroll-margin-top: 40px;
        margin: 64px 0 22px;
        padding: 18px 22px;

        background: var(--green-light);
        border-left: 4px solid var(--green);

        font-size: 19px;
        line-height: 1.55;
        letter-spacing: -0.02em;
        word-break: keep-all;
      }

      /* #####: 보조 강조 (꼬리 질문 등). 초록 선만 */
      .article-content :global(h5) {
        scroll-margin-top: 40px;
        margin: 44px 0 16px;
        padding: 2px 0 2px 16px;

        border-left: 3px solid var(--green);

        font-size: 17px;
        line-height: 1.55;
        letter-spacing: -0.01em;
        word-break: keep-all;
      }

      .article-content :global(h6) {
        margin: 32px 0 12px;
        font-size: 16px;
        line-height: 1.5;
        letter-spacing: -0.01em;
      }

      .article-content :global(h6) {
        color: var(--muted);
      }

      .article-content :global(del) {
        color: var(--muted);
      }

      .preview-banner {
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 10px 16px;
        background: #b3261e;
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-align: center;
      }

      .article-content :global(p) {
        margin: 0 0 24px;

        font-size: 17px;
        line-height: 1.9;
        letter-spacing: -0.012em;
      }

      .article-content :global(strong) {
        font-weight: 750;
      }

      .article-content :global(a) {
        color: var(--green);

        border-bottom: 1px solid var(--green);
      }

      .article-content :global(ul),
      .article-content :global(ol) {
        margin: 24px 0;
        padding-left: 24px;

        font-size: 17px;
        line-height: 1.85;
      }

      .article-content :global(li) {
        margin: 8px 0;
      }

      .article-content :global(blockquote) {
        margin: 42px 0;
        padding: 26px 30px;

        border-left: 3px solid var(--green);

        background: var(--green-light);
      }

      .article-content :global(blockquote p) {
        margin: 0;

        font-size: 19px;
        font-weight: 600;
        line-height: 1.7;
      }

      .article-content :global(code) {
        padding: 3px 6px;

        border-radius: 4px;

        background: #eef1ef;

        font-family:
          "SFMono-Regular",
          Consolas,
          monospace;

        font-size: 0.9em;
      }

      .article-content :global(pre) {
        overflow-x: auto;

        margin: 36px 0;
        padding: 26px;

        border-radius: 2px;

        background: #171a19;
        color: #f7f8f7;
      }

      .article-content :global(pre code) {
        padding: 0;

        background: transparent;
        color: inherit;
      }

      .article-content :global(img) {
        display: block;

        width: 100%;
        height: auto;

        margin: 42px 0;
      }

      /* =========================
         MATH
      ========================= */

      .article-content :global(.katex-display) {
        overflow-x: auto;

        margin: 38px 0;
        padding: 24px 20px;

        background: var(--green-light);
      }

      .article-content :global(.katex-display > .katex) {
        text-align: center;
      }

      .article-content :global(.katex) {
        font-size: 1.02em;
      }

      /* =========================
         REFERENCES
      ========================= */

      .article-content :global(h2#references) {
        margin-top: 96px;
        padding-top: 40px;

        border-top: 1px solid var(--line);
      }

      .article-content :global(h2#references + ol),
      .article-content :global(h2#references + ul) {
        margin-top: 28px;
        padding-left: 0;

        list-style: none;

        counter-reset: reference;
      }

      .article-content :global(h2#references + ol li),
      .article-content :global(h2#references + ul li) {
        position: relative;

        margin: 0;
        padding: 18px 0 18px 44px;

        border-bottom: 1px solid var(--line);

        color: var(--muted);

        font-size: 14px;
        line-height: 1.7;
      }

      .article-content :global(h2#references + ol li) {
        counter-increment: reference;
      }

      .article-content :global(h2#references + ol li::before) {
        content: counter(reference, decimal-leading-zero);

        position: absolute;
        left: 0;
        top: 19px;

        color: var(--green);

        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .article-content :global(h2#references + ul li::before) {
        content: "↗";

        position: absolute;
        left: 0;
        top: 17px;

        color: var(--green);

        font-size: 13px;
        font-weight: 800;
      }

      .article-content :global(h2#references + ol li a),
      .article-content :global(h2#references + ul li a) {
        color: var(--text);

        border-bottom: 1px solid transparent;

        font-weight: 600;

        transition:
          color 160ms ease,
          border-color 160ms ease;
      }

      .article-content :global(h2#references + ol li a:hover),
      .article-content :global(h2#references + ul li a:hover) {
        color: var(--green);
        border-bottom-color: var(--green);
      }

      .article-content :global(hr) {
        margin: 72px 0;

        border: 0;
        border-top: 1px solid var(--line);
      }

      .article-content :global(table) {
        width: 100%;

        margin: 36px 0;

        border-collapse: collapse;

        font-size: 14px;
        line-height: 1.6;
      }

      .article-content :global(th),
      .article-content :global(td) {
        padding: 14px 16px;

        border: 1px solid var(--line);

        text-align: left;
      }

      .article-content :global(th) {
        background: var(--green-light);

        font-weight: 700;
      }

      /* =========================
         AUTHOR LINK
      ========================= */

      .author-link {
        color: var(--text);

        font-weight: 700;

        border-bottom: 1px solid transparent;

        transition:
          color 160ms ease,
          border-color 160ms ease;
      }

      .author-link:hover {
        color: var(--green);
        border-bottom-color: var(--green);
      }

      /* =========================
         RIGHT CONTENTS
      ========================= */

      .right-rail {
        position: sticky;
        top: 32px;

        align-self: start;

        padding-left: 30px;

        border-left: 1px solid var(--line);
      }

      .right-title {
        margin-bottom: 26px;

        color: var(--green);

        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.16em;
      }

      .toc {
        display: flex;
        flex-direction: column;
      }

      .toc-item {
        display: grid;

        grid-template-columns: 30px 1fr;
        gap: 12px;

        padding: 11px 0;

        color: var(--muted);

        font-size: 11px;
        font-weight: 650;
        line-height: 1.5;
        letter-spacing: 0.03em;

        transition:
          color 160ms ease,
          transform 160ms ease;
      }

      .toc-item:hover {
        color: var(--green);

        transform: translateX(3px);
      }

      /* 지금 읽고 있는 섹션 (스크립트가 is-active 부여) */
      .toc-item.is-active {
        color: var(--text);
        transform: translateX(3px);
      }

      .toc-item.is-active .toc-text {
        font-weight: 800;
      }

      /* 인터뷰 질문처럼 긴 제목은 두 줄까지만 */
      .toc-text {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
        word-break: keep-all;
      }

      .toc-number {
        color: var(--green);

        font-variant-numeric: tabular-nums;
      }

      .toc-empty {
        color: var(--muted);

        font-size: 12px;
        line-height: 1.65;
      }

      /* =========================
         ARTICLE END
      ========================= */

      .article-end {
        padding: 48px 0 80px;

        border-top: 1px solid var(--line);
      }

      /* =========================
         READING PROGRESS
      ========================= */

      .reading-progress {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 200;

        width: 100%;
        height: 3px;

        background: var(--green);

        transform: scaleX(0);
        transform-origin: left;
        pointer-events: none;
      }

      /* =========================
         NEXT READS
      ========================= */

      .next-reads {
        padding: 72px 0 24px;

        border-top: 1px solid var(--line);
      }

      .next-label {
        margin-bottom: 28px;

        color: var(--green);

        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.14em;
      }

      .next-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }

      .next-card {
        display: flex;
        flex-direction: column;

        min-height: 220px;
        padding: 26px 24px;

        background: var(--white);
        border: 1px solid var(--line);

        transition:
          border-color 160ms ease,
          transform 160ms ease;
      }

      .next-card:hover {
        border-color: var(--green);
        transform: translateY(-3px);
      }

      .next-meta {
        display: flex;
        justify-content: space-between;
        gap: 12px;

        color: var(--green);

        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.12em;
      }

      .next-title {
        margin: 22px 0 10px;

        font-size: 22px;
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -0.03em;
        word-break: keep-all;
      }

      .next-subtitle {
        margin-top: auto;

        color: var(--muted);

        font-size: 14px;
        line-height: 1.6;
        word-break: keep-all;
      }

      .back {
        display: inline-flex;
        align-items: center;

        gap: 10px;

        font-size: 13px;
        font-weight: 700;

        transition:
          color 160ms ease,
          transform 160ms ease;
      }

      .back:hover {
        color: var(--green);

        transform: translateX(-3px);
      }

      /* =========================
         TABLET
      ========================= */

      @media (max-width: 1100px) {
        .article-layout {
          grid-template-columns:
            150px
            minmax(0, 1fr);

          gap: 48px;
        }

        .right-rail {
          display: none;
        }
      }

      /* =========================
         MOBILE
      ========================= */

      @media (max-width: 900px) {
        .page {
          width: min(100% - 28px, 1440px);
        }

        .article-hero {
          padding: 52px 0;
        }

        .article-topline {
          margin-bottom: 44px;
        }

        .article-title {
          font-size: clamp(54px, 17vw, 90px);
        }

        .article-title[data-size="long"] {
          font-size: clamp(38px, 11vw, 60px);
        }

        .article-title[data-size="xlong"] {
          font-size: clamp(32px, 8.5vw, 48px);
        }

        .article-subtitle {
          margin-top: 28px;

          font-size: 20px;
        }

        .article-meta {
          flex-direction: column;

          gap: 10px;

          margin-top: 42px;
        }

        .article-layout {
          display: block;

          padding: 56px 0 90px;
        }

        .article-side,
        .right-rail {
          display: none;
        }

        .article-content :global(h1),
        .article-content :global(h2) {
          font-size: 30px;
        }

        .article-content :global(h3) {
          font-size: 22px;
        }

        .next-grid {
          grid-template-columns: 1fr;
        }

        .next-card {
          min-height: auto;
        }

        .article-content :global(p),
        .article-content :global(ul),
        .article-content :global(ol) {
          font-size: 16px;
        }
      }
    </style>
  </head>

  <body>
    <div class="reading-progress" aria-hidden="true"></div>

    {
      preview && (
        <div class="preview-banner">
          미리보기 · {preview}
        </div>
      )
    }
    <main class="page">
      <Header active={activeCategory} />

      <article>
        <header class="article-hero">
          <div class="article-topline">
            <span>
              {post.data.category}
            </span>

            <span>
              EWHA DS
            </span>
          </div>

          <h1 class="article-title" data-size={titleSize(post.data.title)}>
            {post.data.title}
          </h1>

          <div class="article-subtitle">
            {post.data.subtitle}
          </div>

          <div class="article-meta">
            <div>
              <span>
                WRITTEN BY{" "}
              </span>

              {
                post.data.authorUrl ? (
                  <strong>
                    <a
                      href={post.data.authorUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="author-link"
                    >
                      {post.data.author} ↗
                    </a>
                  </strong>
                ) : (
                  <strong>
                    {post.data.author}
                  </strong>
                )
              }
            </div>

            <div>
              <span>
                PUBLISHED{" "}
              </span>

              <strong>
                {formattedDate}
              </strong>
            </div>
          </div>
        </header>

        <div class="article-layout">
          <aside class="article-side">
            <div class="side-block">
              <div class="side-label">
                CATEGORY
              </div>

              <div class="side-value">
                {post.data.category}
              </div>
            </div>

            <div class="side-block">
              <div class="side-label">
                AUTHOR
              </div>

              <div class="side-value">
                {
                  post.data.authorUrl ? (
                    <a
                      href={post.data.authorUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="author-link"
                    >
                      {post.data.author} ↗
                    </a>
                  ) : (
                    post.data.author
                  )
                }
              </div>
            </div>

            <div class="side-block">
              <div class="side-label">
                PUBLISHED
              </div>

              <div class="side-value">
                {formattedDate}
              </div>
            </div>
          </aside>

          <main class="article-content">
            <Content />
          </main>

          <aside class="right-rail">
            <div class="right-title">
              CONTENTS
            </div>

            {
              tocItems.length > 0 ? (
                <nav class="toc">
                  {
                    tocItems.map((heading, index) => (
                      <a
                        class="toc-item"
                        href={`#${heading.slug}`}
                        data-slug={heading.slug}
                      >
                        <span class="toc-number">
                          {String(index + 1).padStart(2, "0")}
                        </span>

                        <span class="toc-text">
                          {heading.text}
                        </span>
                      </a>
                    ))
                  }
                </nav>
              ) : (
                <div class="toc-empty">
                  목차가 없습니다.
                </div>
              )
            }
          </aside>
        </div>

        {
          nextReads.length > 0 && (
            <section class="next-reads">
              <div class="next-label">
                NEXT READ · 다음에 읽을 글
              </div>

              <div class="next-grid">
                {
                  nextReads.map((p) => (
                    <a class="next-card" href={`/posts/${p.id}/`}>
                      <div class="next-meta">
                        <span>{p.data.category}</span>
                        <span>{shortDate(p.data.date)}</span>
                      </div>

                      <div class="next-title">
                        {p.data.title}
                      </div>

                      <div class="next-subtitle">
                        {p.data.subtitle}
                      </div>
                    </a>
                  ))
                }
              </div>
            </section>
          )
        }

        <div class="article-end">
          <a
            href={`/${post.data.category.toLowerCase()}`}
            class="back"
          >
            ← BACK TO {post.data.category}
          </a>
        </div>
      </article>

      <Footer />
    </main>

    <script>
      // 읽기 진행 바 + 목차 현재 위치 표시
      const content = document.querySelector<HTMLElement>(".article-content");
      const bar = document.querySelector<HTMLElement>(".reading-progress");
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(".toc-item[data-slug]")
      );
      const tocHeadings = tocLinks
        .map((link) => document.getElementById(link.dataset.slug ?? ""))
        .filter((el): el is HTMLElement => el !== null);

      let ticking = false;

      function update() {
        ticking = false;
        if (!content) return;

        // 본문 시작~끝 기준 진행률
        const rect = content.getBoundingClientRect();
        const total = rect.height - window.innerHeight * 0.6;
        const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
        if (bar) bar.style.transform = `scaleX(${progress})`;

        // 화면 위쪽 1/4 지점을 지난 마지막 제목이 현재 섹션
        const line = window.innerHeight * 0.25;
        let current: HTMLElement | undefined;
        for (const heading of tocHeadings) {
          if (heading.getBoundingClientRect().top <= line) current = heading;
          else break;
        }
        for (const link of tocLinks) {
          link.classList.toggle("is-active", link.dataset.slug === current?.id);
        }
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      update();
    </script>
  </body>
</html>
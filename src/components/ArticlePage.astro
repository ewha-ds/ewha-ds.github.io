---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SEO from "./SEO.astro";
import "katex/dist/katex.min.css";

interface Props {
  post: CollectionEntry<"posts">;
  /** 미리보기일 때 상단 띠에 표시할 문구. 없으면 공개 글 */
  preview?: string;
}

const { post, preview } = Astro.props;

const { Content, headings } = await render(post);

const formattedDate = post.data.date
  .toLocaleDateString("en-US", {
    month: "long",
    day: "2-digit",
    year: "numeric",
  })
  .toUpperCase();

const tocItems = headings.filter(
  (heading) => heading.depth <= 2
);

const activeCategory =
  post.data.category === "TECH"
    ? "TECH"
    : post.data.category === "RESEARCH"
      ? "RESEARCH"
      : post.data.category === "CAREER"
        ? "CAREER"
        : undefined;
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {preview && <meta name="robots" content="noindex, nofollow" />}

    <SEO
      title={`${post.data.title} | EWHA DS`}
      description={post.data.description ?? post.data.subtitle}
      image={post.data.ogImage ?? "/default-og.png"}
      type="article"
      publishedTime={post.data.date}
      author={post.data.author}
    />

    <style>
      :root {
        --green: #00664f;
        --green-dark: #004b3c;
        --green-light: #eaf3ef;
        --text: #171a19;
        --muted: #707674;
        --line: #dce4e1;
        --background: #fafbf9;
        --white: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);

        font-family:
          Pretendard,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        width: min(1440px, calc(100% - 48px));
        margin: 0 auto;
      }

      /* =========================
         ARTICLE HERO
      ========================= */

      .article-hero {
        padding: 70px 0 64px;

        border-bottom: 1px solid var(--line);
      }

      .article-topline {
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-bottom: 64px;

        color: var(--green);

        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.14em;
      }

      .article-title {
        max-width: 1100px;
        margin: 0;

        font-size: clamp(64px, 9vw, 138px);
        line-height: 0.88;
        letter-spacing: -0.07em;
        font-weight: 800;
      }

      .article-subtitle {
        max-width: 720px;

        margin-top: 38px;

        color: var(--muted);

        font-size: 24px;
        line-height: 1.55;
        letter-spacing: -0.025em;
      }

      .article-meta {
        display: flex;
        gap: 36px;

        margin-top: 58px;

        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
      }

      .article-meta span {
        color: var(--muted);
      }

      .article-meta strong {
        color: var(--text);
      }

      /* =========================
         ARTICLE GRID
      ========================= */

      .article-layout {
        display: grid;

        grid-template-columns:
          minmax(150px, 190px)
          minmax(0, 760px)
          minmax(170px, 1fr);

        gap: 72px;

        align-items: start;

        padding: 80px 0 120px;
      }

      /* =========================
         LEFT SIDEBAR
      ========================= */

      .article-side {
        position: sticky;
        top: 32px;

        align-self: start;

        color: var(--muted);

        font-size: 12px;
        line-height: 1.8;
      }

      .side-block + .side-block {
        margin-top: 38px;
      }

      .side-label {
        margin-bottom: 14px;

        color: var(--green);

        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.16em;
      }

      .side-value {
        max-width: 150px;
        line-height: 1.6;
      }

      /* =========================
         ARTICLE CONTENT
      ========================= */

      .article-content {
        min-width: 0;
      }

      .article-content :global(h1),
      .article-content :global(h2) {
        scroll-margin-top: 40px;

        margin: 76px 0 26px;
        padding-top: 10px;

        font-size: 36px;
        line-height: 1.25;
        letter-spacing: -0.045em;
      }

      .article-content :global(h1:first-child),
      .article-content :global(h2:first-child) {
        margin-top: 0;
      }

      .article-content :global(h3) {
        scroll-margin-top: 40px;

        margin: 50px 0 18px;

        font-size: 24px;
        line-height: 1.35;
        letter-spacing: -0.03em;
      }

      .article-content :global(h4) {
        scroll-margin-top: 40px;
        margin: 40px 0 14px;
        font-size: 19px;
        line-height: 1.4;
        letter-spacing: -0.02em;
      }

      .article-content :global(h5),
      .article-content :global(h6) {
        margin: 32px 0 12px;
        font-size: 16px;
        line-height: 1.5;
        letter-spacing: -0.01em;
      }

      .article-content :global(h6) {
        color: var(--muted);
      }

      .article-content :global(del) {
        color: var(--muted);
      }

      .preview-banner {
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 10px 16px;
        background: #b3261e;
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-align: center;
      }

      .article-content :global(p) {
        margin: 0 0 24px;

        font-size: 17px;
        line-height: 1.9;
        letter-spacing: -0.012em;
      }

      .article-content :global(strong) {
        font-weight: 750;
      }

      .article-content :global(a) {
        color: var(--green);

        border-bottom: 1px solid var(--green);
      }

      .article-content :global(ul),
      .article-content :global(ol) {
        margin: 24px 0;
        padding-left: 24px;

        font-size: 17px;
        line-height: 1.85;
      }

      .article-content :global(li) {
        margin: 8px 0;
      }

      .article-content :global(blockquote) {
        margin: 42px 0;
        padding: 26px 30px;

        border-left: 3px solid var(--green);

        background: var(--green-light);
      }

      .article-content :global(blockquote p) {
        margin: 0;

        font-size: 19px;
        font-weight: 600;
        line-height: 1.7;
      }

      .article-content :global(code) {
        padding: 3px 6px;

        border-radius: 4px;

        background: #eef1ef;

        font-family:
          "SFMono-Regular",
          Consolas,
          monospace;

        font-size: 0.9em;
      }

      .article-content :global(pre) {
        overflow-x: auto;

        margin: 36px 0;
        padding: 26px;

        border-radius: 2px;

        background: #171a19;
        color: #f7f8f7;
      }

      .article-content :global(pre code) {
        padding: 0;

        background: transparent;
        color: inherit;
      }

      .article-content :global(img) {
        display: block;

        width: 100%;
        height: auto;

        margin: 42px 0;
      }

      /* =========================
         MATH
      ========================= */

      .article-content :global(.katex-display) {
        overflow-x: auto;

        margin: 38px 0;
        padding: 24px 20px;

        background: var(--green-light);
      }

      .article-content :global(.katex-display > .katex) {
        text-align: center;
      }

      .article-content :global(.katex) {
        font-size: 1.02em;
      }

      /* =========================
         REFERENCES
      ========================= */

      .article-content :global(h2#references) {
        margin-top: 96px;
        padding-top: 40px;

        border-top: 1px solid var(--line);
      }

      .article-content :global(h2#references + ol),
      .article-content :global(h2#references + ul) {
        margin-top: 28px;
        padding-left: 0;

        list-style: none;

        counter-reset: reference;
      }

      .article-content :global(h2#references + ol li),
      .article-content :global(h2#references + ul li) {
        position: relative;

        margin: 0;
        padding: 18px 0 18px 44px;

        border-bottom: 1px solid var(--line);

        color: var(--muted);

        font-size: 14px;
        line-height: 1.7;
      }

      .article-content :global(h2#references + ol li) {
        counter-increment: reference;
      }

      .article-content :global(h2#references + ol li::before) {
        content: counter(reference, decimal-leading-zero);

        position: absolute;
        left: 0;
        top: 19px;

        color: var(--green);

        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .article-content :global(h2#references + ul li::before) {
        content: "↗";

        position: absolute;
        left: 0;
        top: 17px;

        color: var(--green);

        font-size: 13px;
        font-weight: 800;
      }

      .article-content :global(h2#references + ol li a),
      .article-content :global(h2#references + ul li a) {
        color: var(--text);

        border-bottom: 1px solid transparent;

        font-weight: 600;

        transition:
          color 160ms ease,
          border-color 160ms ease;
      }

      .article-content :global(h2#references + ol li a:hover),
      .article-content :global(h2#references + ul li a:hover) {
        color: var(--green);
        border-bottom-color: var(--green);
      }

      .article-content :global(hr) {
        margin: 72px 0;

        border: 0;
        border-top: 1px solid var(--line);
      }

      .article-content :global(table) {
        width: 100%;

        margin: 36px 0;

        border-collapse: collapse;

        font-size: 14px;
        line-height: 1.6;
      }

      .article-content :global(th),
      .article-content :global(td) {
        padding: 14px 16px;

        border: 1px solid var(--line);

        text-align: left;
      }

      .article-content :global(th) {
        background: var(--green-light);

        font-weight: 700;
      }

      /* =========================
         AUTHOR LINK
      ========================= */

      .author-link {
        color: var(--text);

        font-weight: 700;

        border-bottom: 1px solid transparent;

        transition:
          color 160ms ease,
          border-color 160ms ease;
      }

      .author-link:hover {
        color: var(--green);
        border-bottom-color: var(--green);
      }

      /* =========================
         RIGHT CONTENTS
      ========================= */

      .right-rail {
        position: sticky;
        top: 32px;

        align-self: start;

        padding-left: 30px;

        border-left: 1px solid var(--line);
      }

      .right-title {
        margin-bottom: 26px;

        color: var(--green);

        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.16em;
      }

      .toc {
        display: flex;
        flex-direction: column;
      }

      .toc-item {
        display: grid;

        grid-template-columns: 30px 1fr;
        gap: 12px;

        padding: 11px 0;

        color: var(--muted);

        font-size: 11px;
        font-weight: 650;
        line-height: 1.5;
        letter-spacing: 0.03em;

        transition:
          color 160ms ease,
          transform 160ms ease;
      }

      .toc-item:hover {
        color: var(--green);

        transform: translateX(3px);
      }

      .toc-number {
        color: var(--green);

        font-variant-numeric: tabular-nums;
      }

      .toc-empty {
        color: var(--muted);

        font-size: 12px;
        line-height: 1.65;
      }

      /* =========================
         ARTICLE END
      ========================= */

      .article-end {
        padding: 48px 0 80px;

        border-top: 1px solid var(--line);
      }

      .back {
        display: inline-flex;
        align-items: center;

        gap: 10px;

        font-size: 13px;
        font-weight: 700;

        transition:
          color 160ms ease,
          transform 160ms ease;
      }

      .back:hover {
        color: var(--green);

        transform: translateX(-3px);
      }

      /* =========================
         TABLET
      ========================= */

      @media (max-width: 1100px) {
        .article-layout {
          grid-template-columns:
            150px
            minmax(0, 1fr);

          gap: 48px;
        }

        .right-rail {
          display: none;
        }
      }

      /* =========================
         MOBILE
      ========================= */

      @media (max-width: 900px) {
        .page {
          width: min(100% - 28px, 1440px);
        }

        .article-hero {
          padding: 52px 0;
        }

        .article-topline {
          margin-bottom: 44px;
        }

        .article-title {
          font-size: clamp(54px, 17vw, 90px);
        }

        .article-subtitle {
          margin-top: 28px;

          font-size: 20px;
        }

        .article-meta {
          flex-direction: column;

          gap: 10px;

          margin-top: 42px;
        }

        .article-layout {
          display: block;

          padding: 56px 0 90px;
        }

        .article-side,
        .right-rail {
          display: none;
        }

        .article-content :global(h1),
        .article-content :global(h2) {
          font-size: 30px;
        }

        .article-content :global(h3) {
          font-size: 22px;
        }

        .article-content :global(p),
        .article-content :global(ul),
        .article-content :global(ol) {
          font-size: 16px;
        }
      }
    </style>
  </head>

  <body>
    {
      preview && (
        <div class="preview-banner">
          미리보기 · {preview}
        </div>
      )
    }
    <main class="page">
      <Header active={activeCategory} />

      <article>
        <header class="article-hero">
          <div class="article-topline">
            <span>
              {post.data.category}
            </span>

            <span>
              EWHA DS
            </span>
          </div>

          <h1 class="article-title">
            {post.data.title}
          </h1>

          <div class="article-subtitle">
            {post.data.subtitle}
          </div>

          <div class="article-meta">
            <div>
              <span>
                WRITTEN BY{" "}
              </span>

              {
                post.data.authorUrl ? (
                  <strong>
                    <a
                      href={post.data.authorUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="author-link"
                    >
                      {post.data.author} ↗
                    </a>
                  </strong>
                ) : (
                  <strong>
                    {post.data.author}
                  </strong>
                )
              }
            </div>

            <div>
              <span>
                PUBLISHED{" "}
              </span>

              <strong>
                {formattedDate}
              </strong>
            </div>
          </div>
        </header>

        <div class="article-layout">
          <aside class="article-side">
            <div class="side-block">
              <div class="side-label">
                CATEGORY
              </div>

              <div class="side-value">
                {post.data.category}
              </div>
            </div>

            <div class="side-block">
              <div class="side-label">
                AUTHOR
              </div>

              <div class="side-value">
                {
                  post.data.authorUrl ? (
                    <a
                      href={post.data.authorUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="author-link"
                    >
                      {post.data.author} ↗
                    </a>
                  ) : (
                    post.data.author
                  )
                }
              </div>
            </div>

            <div class="side-block">
              <div class="side-label">
                PUBLISHED
              </div>

              <div class="side-value">
                {formattedDate}
              </div>
            </div>
          </aside>

          <main class="article-content">
            <Content />
          </main>

          <aside class="right-rail">
            <div class="right-title">
              CONTENTS
            </div>

            {
              tocItems.length > 0 ? (
                <nav class="toc">
                  {
                    tocItems.map((heading, index) => (
                      <a
                        class="toc-item"
                        href={`#${heading.slug}`}
                      >
                        <span class="toc-number">
                          {String(index + 1).padStart(2, "0")}
                        </span>

                        <span>
                          {heading.text}
                        </span>
                      </a>
                    ))
                  }
                </nav>
              ) : (
                <div class="toc-empty">
                  목차가 없습니다.
                </div>
              )
            }
          </aside>
        </div>

        <div class="article-end">
          <a
            href={`/${post.data.category.toLowerCase()}`}
            class="back"
          >
            ← BACK TO {post.data.category}
          </a>
        </div>
      </article>

      <Footer />
    </main>
  </body>
</html>
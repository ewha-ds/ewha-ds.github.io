---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  author?: string;
}

const {
  title,
  description = "EWHA DS · Tech · Research · Career",
  image = "/default-og.png",
  type = "website",
  publishedTime,
  author,
} = Astro.props;

const siteName = "EWHA DS";

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.toString();

const imageURL = Astro.site
  ? new URL(image, Astro.site).toString()
  : new URL(image, Astro.url).toString();
---

<title>{title}</title>

<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<!-- 검색엔진 소유 확인 (Google Search Console). 지우면 확인이 풀림 -->
<meta name="google-site-verification" content="TdiH3zi4Vyd6apSnoNQKDtkWa4LABMgyJ4H9jvDhIuY" />
<link rel="sitemap" href="/sitemap.xml" />
<link rel="alternate" type="application/rss+xml" title="EWHA DS" href="/rss.xml" />

<!-- Favicon -->
<link rel="icon" type="image/png" href="/eds-favicon.png" />
<link rel="shortcut icon" href="/eds-favicon.png" />
<link rel="apple-touch-icon" href="/eds-favicon.png" />

<!-- Open Graph -->
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

{
  type === "article" && publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}

{
  type === "article" && author && (
    <meta property="article:author" content={author} />
  )
}